rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Users collection:
    // Anyone can read (needed to check if master exists during signup).
    // Only authenticated users can write their own user document.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /notificationDevices/{deviceId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 2. All other collections:
    // Any authenticated user can read and write.
    // Data isolation is enforced in the app code using where('userId', '==', uid) queries.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
