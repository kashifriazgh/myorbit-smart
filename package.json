{
  "name": "my-orbit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node cleanup-dev.js && npm run dev",
    "dev:fast": "next dev --port 3001 --turbo",
    "dev:turbo": "next dev --turbo",
    "dev:components": "next dev --port 3000 --experimental-watch-mode=components",
    "dev:pages": "next dev --port 3000 --experimental-watch-mode=pages",
    "dev:lib": "next dev --port 3000 --experimental-watch-mode=lib",
    "dev:selective": "node scripts/dev-selective.js",
    "dev:components-only": "node scripts/dev-selective.js app/components",
    "dev:lib-only": "node scripts/dev-selective.js app/lib",
    "dev:pages-only": "node scripts/dev-selective.js app",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "clean": "node cleanup-dev.js"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.1.2",
    "@mui/lab": "^7.0.0-beta.16",
    "@mui/material": "^7.1.2",
    "@mui/x-date-pickers": "^8.10.0",
    "chart.js": "^4.5.0",
    "compromise": "^14.14.4",
    "dexie": "^4.0.11",
    "firebase": "^11.9.1",
    "framer-motion": "^12.23.12",
    "js-cookie": "^3.0.5",
    "keen-slider": "^6.8.6",
    "lottie-react": "^2.4.1",
    "minimatch": "^10.0.3",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "next": "15.3.4",
    "next-pwa": "^5.6.0",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-date-range": "^2.0.1",
    "react-datepicker": "^8.4.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.1.0",
    "round-slider": "^1.6.1",
    "wink-nlp": "^2.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/js-cookie": "^3.0.6",
    "@types/minimatch": "^6.0.0",
    "@types/moment-timezone": "^0.5.30",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
